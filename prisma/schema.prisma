generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

enum UserRole {
  site_admin
  web_app_admin
  toolkit_admin
  web_app_user
  toolkit_user
}

enum VulnerabilityStatus {
  Open
  Remediated
  FalsePositive
  NoFixAvailable
  InProgress
  InProgressWithCR
}

enum Risk {
  Critical
  High
  Medium
  Low
  None
}

enum UploadStatus {
  Processing
  Completed
  Failed
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  name          String
  roles         UserRole[]       @default([web_app_user])
  authSource    String           @default("Local")
  vulnerabilities Vulnerability[] @relation("Assignee")
  collaboratingVulnerabilities Vulnerability[] @relation("Collaborators")
  comments      Comment[]
  vulnerabilityHistory VulnerabilityHistory[]
  uploads       UploadHistory[]  @relation("UploadedBy")
  pentestExecutions PentestExecution[]
  assignmentNotifications AssignmentNotification[]
  threatSubscription ThreatSubscription?
  createdAt     DateTime         @default(now())
}

model Site {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @unique
  createdAt     DateTime         @default(now())
  vulnerabilities Vulnerability[]
  vulnerabilityHistory VulnerabilityHistory[]
  uploads       UploadHistory[]
  importPattern String?
  importAliases String[]         @default([])
  autoImportEnabled Boolean      @default(true)
}

model Vulnerability {
  id                       String               @id @default(uuid()) @db.Uuid
  siteId                   String               @db.Uuid
  assigneeId               String?              @db.Uuid
  status                   VulnerabilityStatus  @default(Open)
  isCurrent                Boolean              @default(true)
  lastSeenAt               DateTime
  createdAt                DateTime             @default(now())
  pluginId                 String
  cve                      String?
  cvssScore                Float?
  risk                     Risk                 @default(None)
  host                     String
  protocol                 String
  port                     String
  name                     String
  synopsis                 String?
  description              String?
  solution                 String?
  seeAlso                  String?
  pluginOutput             String?
  pluginPublicationDate    DateTime?
  pluginModificationDate   DateTime?
  crNumber                 String?
  
  askForHelp               Boolean              @default(false)
  collaborators            User[]               @relation("Collaborators")
  comments                 Comment[]
  assignmentNotifications AssignmentNotification[]

  site                     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee                 User?                @relation("Assignee", fields: [assigneeId], references: [id])

  @@index([siteId, pluginId, host, port])
  @@index([status])
  @@index([risk])
  @@index([siteId, status, risk])
  @@index([risk, lastSeenAt(sort: Desc)])
}

model OidcConfig {
  id               String   @id @default(uuid()) @db.Uuid
  clientIdEnc      String
  clientSecretEnc  String
  issuerUrlEnc     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ReportConfig {
  id             String   @id @default(uuid()) @db.Uuid
  enabled        Boolean  @default(false)
  recipients     String
  dayOfWeek      Int      @default(1)
  hour           Int      @default(9)
  minute         Int      @default(0)
  timezone       String   @default("UTC")
  lastSentAt     DateTime?
  lastThreatDigestAt DateTime?
  smtpHostEnc    String
  smtpPortEnc    String
  smtpUserEnc    String?
  smtpPassEnc    String?
  smtpSecureEnc  String
  smtpFromEnc    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UploadHistory {
  id         String   @id @default(uuid()) @db.Uuid
  siteId     String   @db.Uuid
  uploadedBy String?  @db.Uuid
  uploadDate DateTime @default(now())
  status     UploadStatus @default(Processing)
  fileName   String?
  rowCount   Int?

  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploader   User?    @relation("UploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([siteId, uploadDate])
}

enum AzureAuthMethod {
  CONNECTION_STRING
  ACCOUNT_KEY
  SAS_TOKEN
}

enum StorageProvider {
  AZURE
  REDIS
}

model StorageConfig {
  id                        String           @id @default("singleton")
  provider                  StorageProvider  @default(REDIS)
  azureAuthMethod           AzureAuthMethod  @default(CONNECTION_STRING)
  azureConnectionStringEnc  String?
  azureAccountName          String?
  azureAccountKeyEnc        String?
  azureSasTokenEnc          String?
  azureContainerName        String?          @default("uploads")
  updatedAt                 DateTime         @updatedAt
}

model ImportConfig {
  id                    String   @id @default("singleton")
  pluginGracePeriodDays Int      @default(30)
  updatedAt             DateTime @updatedAt
}

model AzureFileShareConfig {
  id                    String   @id @default("singleton")
  enabled               Boolean  @default(false)
  connectionStringEnc   String?
  accountName           String?
  accountKeyEnc         String?
  sasTokenEnc           String?
  shareName             String?  @default("security-scans")
  directoryPath         String?  @default("/")
  pollIntervalMinutes   Int      @default(60)
  deleteAfterImport     Boolean  @default(true)
  lastPollAt            DateTime?
  updatedAt             DateTime @updatedAt
}

model PentestExecution {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  toolId      String
  toolName    String
  inputs      Json
  status      String
  output      String?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([toolId, startedAt(sort: Desc)])
}

model VulnerabilityHistory {
  id                       String               @id @default(uuid()) @db.Uuid
  siteId                   String               @db.Uuid
  assigneeId               String?              @db.Uuid
  status                   VulnerabilityStatus  @default(Remediated)
  lastSeenAt               DateTime
  archivedAt               DateTime             @default(now())
  createdAt                DateTime
  pluginId                 String
  cve                      String?
  cvssScore                Float?
  risk                     Risk                 @default(None)
  host                     String
  protocol                 String
  port                     String
  name                     String
  synopsis                 String?
  description              String?
  solution                 String?
  seeAlso                  String?
  pluginOutput             String?
  pluginPublicationDate    DateTime?
  pluginModificationDate   DateTime?
  crNumber                 String?

  site                     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee                 User?                @relation(fields: [assigneeId], references: [id])

  @@index([lastSeenAt])
  @@index([archivedAt])
  @@index([siteId, risk])
}

model Comment {
  id              String        @id @default(uuid()) @db.Uuid
  content         String
  vulnerabilityId String        @db.Uuid
  authorId        String        @db.Uuid
  isPrivate       Boolean       @default(true)
  createdAt       DateTime      @default(now())

  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorId], references: [id])

  @@index([vulnerabilityId, createdAt(sort: Desc)])
}

model AssignmentNotification {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  vulnerabilityId String        @db.Uuid
  createdAt       DateTime      @default(now())
  sentAt          DateTime?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model ThreatVulnerability {
  id                     String    @id @default(uuid()) @db.Uuid
  osvId                  String    @unique // e.g., GHSA-..., OSV-...
  cveId                  String?   @unique // e.g., CVE-2024-...
  summary                String
  details                String?
  source                 String    // e.g., NVD, OSV, CISCO
  
  // OSV-based relationships (simplified for mirroring)
  affectedPackages       Json      // List of affected packages and versions
  remediation            String?   // "Upgrade to version X"
  
  // Enrichment fields
  cvssScore              Float?
  epssScore              Float?
  cisaKevStatus          Boolean   @default(false)
  
  publishedAt            DateTime
  modifiedAt             DateTime
  syncedAt               DateTime  @default(now())

  @@index([cveId])
  @@index([publishedAt(sort: Desc)])
  @@index([cvssScore(sort: Desc)])
  @@index([cisaKevStatus])
}

model ThreatSubscription {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  isSubscribed     Boolean  @default(false)
  
  // Alert Preferences
  minRisk          Risk     @default(High) // Subscriber only wants High/Critical
  cisaKevOnly      Boolean  @default(false)
  
  // Custom Schedule (UTC)
  scheduledHour    Int      @default(8)
  scheduledMinute  Int      @default(0)
  lastSentAt       DateTime?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt
}

model ThreatFeedMetadata {
  id            String   @id // e.g., "NVD", "OSV", "CISA_KEV"
  lastModified  DateTime?
  sha256Hash    String?
  lastSyncedAt  DateTime @default(now())
}
