generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

enum UserRole {
  site_admin
  web_app_admin
  toolkit_admin
  web_app_user
  toolkit_user
  web_app_auditor
}

enum GroupMemberRole {
  member
  leader
}

enum VulnerabilityStatus {
  Open
  Remediated
  FalsePositive
  NoFixAvailable
  InProgress
  InProgressWithCR
  Sunset
  AwaitingVendor
}

enum Risk {
  Critical
  High
  Medium
  Low
  None
}

enum UploadStatus {
  Processing
  Completed
  Failed
}

enum UploadType {
  CSV
  PDF
}

// Scanner / source type for uploaded vulnerability data. Used to distinguish
// rows produced by different scanners (currently Nessus and Azure Container
// Registry) so they can be filtered, rendered, and reconciled correctly while
// sharing the same Vulnerability table + dashboards.
enum ScannerType {
  NESSUS
  ACR
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  name          String
  roles         UserRole[]       @default([web_app_user])
  authSource    String           @default("Local")
  vulnerabilities Vulnerability[] @relation("Assignee")
  collaboratingVulnerabilities Vulnerability[] @relation("Collaborators")
  comments      Comment[]
  vulnerabilityHistory VulnerabilityHistory[]
  uploads       UploadHistory[]  @relation("UploadedBy")
  pentestExecutions PentestExecution[]
  assignmentNotifications AssignmentNotification[]
  threatSubscription ThreatSubscription?
  groupMemberships GroupMembership[]
  dashboards    Dashboard[]
  isNewUser     Boolean          @default(true)
  lastLoginAt   DateTime         @default(now())
  completedTours String[]        @default([])
  lastWeeklyAssignmentReportAt DateTime?
  createdAt     DateTime         @default(now())
}

model Group {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @unique
  description    String?
  idpGroupId     String?             // reserved for future OIDC/Entra group sync
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  memberships    GroupMembership[]
  vulnerabilities Vulnerability[]
  vulnerabilityHistory VulnerabilityHistory[]
}

model GroupMembership {
  groupId   String          @db.Uuid
  userId    String          @db.Uuid
  role      GroupMemberRole @default(member)
  createdAt DateTime        @default(now())

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model Site {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @unique
  createdAt     DateTime         @default(now())
  vulnerabilities Vulnerability[]
  vulnerabilityHistory VulnerabilityHistory[]
  uploads       UploadHistory[]
  importPattern String?
  importAliases String[]         @default([])
  autoImportEnabled Boolean      @default(true)

  azureBlobIngestDefaults AzureBlobIngestConfig[] @relation("AzureBlobDefaultSite")
}

model Vulnerability {
  id                       String               @id @default(uuid()) @db.Uuid
  siteId                   String               @db.Uuid
  assigneeId               String?              @db.Uuid
  groupId                  String?              @db.Uuid
  status                   VulnerabilityStatus  @default(Open)
  isCurrent                Boolean              @default(true)
  lastSeenAt               DateTime
  createdAt                DateTime             @default(now())
  scannerType              ScannerType          @default(NESSUS)
  pluginId                 String
  cve                      String?
  cvssScore                Float?
  risk                     Risk                 @default(None)
  host                     String
  protocol                 String
  port                     String
  name                     String
  synopsis                 String?
  description              String?
  solution                 String?
  seeAlso                  String?
  pluginOutput             String?
  pluginPublicationDate    DateTime?
  pluginModificationDate   DateTime?
  crNumber                 String?

  // ACR-specific fidelity columns. Nullable so Nessus rows leave them blank.
  // For ACR rows the Nessus fields above are populated semantically:
  //   pluginId = cveId, host = registryName/repository, port = packageName,
  //   protocol = "container", name = "{cveId} — {packageName} {installedVersion}".
  registryName             String?
  repository               String?
  imageDigest              String?
  imageTag                 String?
  packageName              String?
  installedVersion         String?
  remediation              String?
  timeGenerated            DateTime?

  askForHelp               Boolean              @default(false)
  collaborators            User[]               @relation("Collaborators")
  comments                 Comment[]
  assignmentNotifications AssignmentNotification[]

  site                     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee                 User?                @relation("Assignee", fields: [assigneeId], references: [id])
  group                    Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([siteId, pluginId, host, port])
  @@index([status])
  @@index([risk])
  @@index([siteId, status, risk])
  @@index([risk, lastSeenAt(sort: Desc)])
  @@index([groupId, status])
  @@index([siteId, scannerType, imageDigest])
  @@index([siteId, scannerType, status])
}

model OidcConfig {
  id               String   @id @default(uuid()) @db.Uuid
  clientIdEnc      String
  clientSecretEnc  String
  issuerUrlEnc     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Connection settings for the AI-powered natural-language insights feature.
// `providerType` selects the request shape (Azure OpenAI deployment URLs, Azure
// AI Foundry, or any OpenAI-compatible /v1 endpoint such as OpenAI or Ollama).
// `baseUrlEnc` and `apiKeyEnc` are AES-256-GCM encrypted (see lib/crypto). The
// `model` (deployment name for Azure) and `apiVersion` are non-secret.
model AiConfig {
  id           String   @id @default(uuid()) @db.Uuid
  enabled      Boolean  @default(true)
  providerType String   @default("openai-compatible")
  baseUrlEnc   String
  apiKeyEnc    String
  model        String
  apiVersion   String?
  /// Display name for the assistant across the UI. Null falls back to "Ask AI".
  assistantName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReportConfig {
  id             String   @id @default(uuid()) @db.Uuid
  enabled        Boolean  @default(false)
  recipients     String
  dayOfWeek      Int      @default(1)
  hour           Int      @default(9)
  minute         Int      @default(0)
  timezone       String   @default("UTC")
  lastSentAt     DateTime?
  lastThreatDigestAt DateTime?
  smtpHostEnc    String
  smtpPortEnc    String
  smtpUserEnc    String?
  smtpPassEnc    String?
  smtpSecureEnc  String
  smtpFromEnc    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UploadHistory {
  id           String       @id @default(uuid()) @db.Uuid
  siteId       String       @db.Uuid
  uploadedBy   String?      @db.Uuid
  uploadDate   DateTime     @default(now())
  status       UploadStatus @default(Processing)
  uploadType   UploadType   @default(CSV)
  scannerType  ScannerType  @default(NESSUS)
  fileName     String?
  rowCount     Int?

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploader     User?        @relation("UploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([siteId, uploadDate])
  @@index([scannerType, uploadDate])
}

enum AzureAuthMethod {
  CONNECTION_STRING
  ACCOUNT_KEY
  SAS_TOKEN
}

enum StorageProvider {
  AZURE
  REDIS
}

model StorageConfig {
  id                        String           @id @default("singleton")
  provider                  StorageProvider  @default(REDIS)
  azureAuthMethod           AzureAuthMethod  @default(CONNECTION_STRING)
  azureConnectionStringEnc  String?
  azureAccountName          String?
  azureAccountKeyEnc        String?
  azureSasTokenEnc          String?
  azureContainerName        String?          @default("uploads")
  updatedAt                 DateTime         @updatedAt
}

model ImportConfig {
  id                    String   @id @default("singleton")
  pluginGracePeriodDays Int      @default(30)
  updatedAt             DateTime @updatedAt
}

model AzureFileShareConfig {
  id                    String   @id @default("singleton")
  enabled               Boolean  @default(false)
  connectionStringEnc   String?
  accountName           String?
  accountKeyEnc         String?
  sasTokenEnc           String?
  shareName             String?  @default("security-scans")
  directoryPath         String?  @default("/")
  pollIntervalMinutes   Int      @default(60)
  deleteAfterImport     Boolean  @default(true)
  lastPollAt            DateTime?
  updatedAt             DateTime @updatedAt
}

// Independent config for polling an Azure Blob container for ACR vulnerability
// CSV exports. Sits alongside StorageConfig + AzureFileShareConfig so admins
// can point at a completely separate storage account with its own credentials.
model AzureBlobIngestConfig {
  id                    String           @id @default("singleton")
  enabled               Boolean          @default(false)
  authMethod            AzureAuthMethod  @default(CONNECTION_STRING)
  connectionStringEnc   String?
  accountName           String?
  accountKeyEnc         String?
  sasTokenEnc           String?
  containerName         String?          @default("acr-vulnerabilities")
  prefix                String?          @default("")
  defaultSiteId         String?          @db.Uuid
  pollIntervalMinutes   Int              @default(60)
  deleteAfterImport     Boolean          @default(true)
  lastPollAt            DateTime?
  updatedAt             DateTime         @updatedAt

  defaultSite           Site?            @relation("AzureBlobDefaultSite", fields: [defaultSiteId], references: [id], onDelete: SetNull)
}

model PentestExecution {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  toolId      String
  toolName    String
  inputs      Json
  status      String
  output      String?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([toolId, startedAt(sort: Desc)])
}

model VulnerabilityHistory {
  id                       String               @id @default(uuid()) @db.Uuid
  siteId                   String               @db.Uuid
  assigneeId               String?              @db.Uuid
  groupId                  String?              @db.Uuid
  status                   VulnerabilityStatus  @default(Remediated)
  lastSeenAt               DateTime
  archivedAt               DateTime             @default(now())
  createdAt                DateTime
  scannerType              ScannerType          @default(NESSUS)
  pluginId                 String
  cve                      String?
  cvssScore                Float?
  risk                     Risk                 @default(None)
  host                     String
  protocol                 String
  port                     String
  name                     String
  synopsis                 String?
  description              String?
  solution                 String?
  seeAlso                  String?
  pluginOutput             String?
  pluginPublicationDate    DateTime?
  pluginModificationDate   DateTime?
  crNumber                 String?

  // ACR-specific fidelity columns (mirror Vulnerability).
  registryName             String?
  repository               String?
  imageDigest              String?
  imageTag                 String?
  packageName              String?
  installedVersion         String?
  remediation              String?
  timeGenerated            DateTime?

  site                     Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee                 User?                @relation(fields: [assigneeId], references: [id])
  group                    Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([archivedAt])
  @@index([siteId, risk])
  @@index([groupId])
  @@index([siteId, scannerType])
  @@index([siteId, scannerType, status])
}

model Comment {
  id              String        @id @default(uuid()) @db.Uuid
  content         String
  vulnerabilityId String        @db.Uuid
  authorId        String        @db.Uuid
  isPrivate       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  // Comments posted as part of the same bulk-comment action share a batchId so
  // they can later be edited/deleted together.
  batchId         String?       @db.Uuid

  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorId], references: [id])

  @@index([vulnerabilityId, createdAt(sort: Desc)])
  @@index([batchId])
}

model AssignmentNotification {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  vulnerabilityId String        @db.Uuid
  createdAt       DateTime      @default(now())
  sentAt          DateTime?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model ThreatVulnerability {
  id                     String    @id @default(uuid()) @db.Uuid
  osvId                  String    @unique // e.g., GHSA-..., OSV-...
  cveId                  String?   @unique // e.g., CVE-2024-...
  summary                String
  details                String?
  source                 String    // e.g., NVD, OSV, CISCO
  
  // OSV-based relationships (simplified for mirroring)
  affectedPackages       Json      // List of affected packages and versions
  remediation            String?   // "Upgrade to version X"
  
  // Enrichment fields
  cvssScore              Float?
  epssScore              Float?
  cisaKevStatus          Boolean   @default(false)
  
  publishedAt            DateTime
  modifiedAt             DateTime
  syncedAt               DateTime  @default(now())

  @@index([cveId])
  @@index([publishedAt(sort: Desc)])
  @@index([cvssScore(sort: Desc)])
  @@index([cisaKevStatus])
}

model ThreatSubscription {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @unique @db.Uuid
  isSubscribed              Boolean  @default(false)
  
  // Alert Feed Toggles
  globalDigestEnabled       Boolean  @default(true)
  environmentDigestEnabled  Boolean  @default(false)

  // Alert Preferences
  minRisk                   Risk     @default(High) // Subscriber only wants High/Critical
  cisaKevOnly               Boolean  @default(false)
  
  // Custom Schedule (UTC)
  scheduledHour             Int      @default(8)
  scheduledMinute           Int      @default(0)
  lastSentAt                DateTime?
  lastSentGlobalAt          DateTime?
  lastSentEnvironmentAt     DateTime?

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt                 DateTime @updatedAt
}

model ThreatFeedMetadata {
  id            String   @id // e.g., "NVD", "OSV", "CISA_KEV"
  lastModified  DateTime?
  sha256Hash    String?
  lastSyncedAt  DateTime @default(now())
}

// Adversary groups from the MITRE ATT&CK Enterprise STIX bundle. Structured
// fields (tactics, software) come straight from ATT&CK; attribution fields
// (actorType, origin, sectors, regions) are keyword-derived from the group
// description because ATT&CK does not model them.
model ThreatActor {
  id             String   @id @default(uuid()) @db.Uuid
  externalId     String   @unique // MITRE group id, e.g. "G0007"
  stixId         String   @unique
  name           String
  aliases        String[]
  description    String?
  actorType      String? // "State Sponsored" | "Cybercrime" | "Hacktivist"
  origin         String?
  targetSectors  String[]
  targetRegions  String[]
  targetTechnologies String[]
  tactics        String[]
  software       String[]
  techniqueCount Int      @default(0)
  url            String?
  lastModified   DateTime
  syncedAt       DateTime @default(now())

  @@index([name])
  @@index([actorType])
  @@index([lastModified(sort: Desc)])
}

enum DashboardVisibility {
  Private
  Published
}

// Personal dashboards. Widgets store a validated query *spec* (never SQL and
// never cached results) so every viewer's data is re-scoped to their own RBAC.
model Dashboard {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @db.Uuid
  name        String
  description String?
  visibility  DashboardVisibility @default(Private)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  widgets DashboardWidget[]

  @@index([ownerId])
  @@index([visibility])
}

model DashboardWidget {
  id          String   @id @default(uuid()) @db.Uuid
  dashboardId String   @db.Uuid
  title       String
  viz         String // stat | bar | line | donut | table
  spec        Json
  x           Int      @default(0)
  y           Int      @default(0)
  w           Int      @default(4)
  h           Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  userEmail   String
  action      String   // e.g., "vulnerability.status_change", "user.role_update", "user.delete"
  entityType  String   // e.g., "Vulnerability", "User", "ReportConfig"
  entityId    String?
  oldValue    String?  // JSON-serialised previous state
  newValue    String?  // JSON-serialised new state
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
}
