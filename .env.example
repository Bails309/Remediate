# Authentication
AUTH_SECRET=replace_with_a_long_random_string # Generates via `npx auth secret`
AUTH_TRUST_HOST=true # MANDATORY for Azure Container Apps / behind proxies
ADMIN_EMAIL=admin@example.com

# App
PORT=3000
NODE_ENV=development
PENTEST_BACKEND_URL=http://localhost:8000 # Set to production URL in Azure

# Database
DATABASE_URL=postgresql://remediate:remediate_password@localhost:5432/remediate?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Examples for TLS / external Redis:
# - Azure Cache for Redis (SSL on port 6380, requires access key):
#   REDIS_URL=rediss://:<PRIMARY_ACCESS_KEY>@your-redis-host.redis.cache.windows.net:6380
# - External TLS without auth (host only):
#   REDIS_URL=rediss://your-redis-host:6380
# - External TLS with password:
#   REDIS_URL=rediss://:yourpassword@your-redis-host:6380
# Control certificate verification (default: verify):
REDIS_TLS_REJECT_UNAUTHORIZED=true
# If you need to skip verification (not recommended):
# REDIS_TLS_REJECT_UNAUTHORIZED=false
# For external Redis with TLS (rediss://), set to false if the provider uses self-signed certs


# Auth (OIDC)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_string
AUTH_SECRET=replace_with_a_long_random_string
AUTH_TRUST_HOST=true

# Pentest backend
PENTEST_BACKEND_URL=http://pentest-backend:8000


# Local auth (useful for first-time setup or emergency access)
# If enabled, you can sign in using local credentials even in production.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USER=localadmin
LOCAL_AUTH_PASS=change_me
LOCAL_AUTH_EMAIL=admin@example.com
LOCAL_AUTH_NAME=Local Admin

# SMTP (configured via UI, stored encrypted)
# Leave empty unless you prefer to set SMTP via UI only.
